<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.meinil.resource.mapper.ResFileMapper">
    <resultMap type="com.meinil.resource.domain.entity.ResFile" id="ResFileResult">
        <id     property="id"                 column="id"                    />
        <result property="fileName"           column="file_name"             />
        <result property="fileSuffix"         column="file_suffix"           />
        <result property="path"               column="path"                  />
        <result property="storageType"        column="storage_type"          />
        <result property="hash"               column="hash"                  />
        <result property="fileSize"           column="file_size"             />
        <result property="delFlag"            column="del_flag"              />
        <result property="createBy"           column="create_by"             />
        <result property="createTime"         column="create_time"           />
        <result property="updateBy"           column="update_by"             />
        <result property="updateTime"         column="update_time"           />
    </resultMap>

    <sql id="BaseField">id, file_name, file_suffix, path, storage_type, hash, file_size, del_flag, create_by, create_time, update_by, update_time</sql>

    <select id="selectByHash" resultMap="ResFileResult">
        SELECT <include refid="BaseField" /> FROM res_file WHERE hash = #{hash} AND del_flag = 0
    </select>
</mapper>